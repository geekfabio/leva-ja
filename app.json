{
  "expo": {
    "name": "AngoLeva",
    "slug": "angoleva",
    "scheme": "angoleva",
    "version": "0.1.0",
    "icon": "./assets/icons/app-icon.png",
    "splash": {
      "image": "./assets/brand/angoleva-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#053420"
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "ao.angoleva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#34D186"
      }
    },
    "ios": {
      "bundleIdentifier": "ao.angoleva.app"
    }
  }
}
