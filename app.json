{
  "expo": {
    "name": "Leva Já",
    "slug": "leva-ja",
    "scheme": "levaja",
    "version": "0.1.0",
    "icon": "./assets/icons/app-icon.png",
    "splash": {
      "image": "./assets/brand/leva-ja-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#053420"
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Leva Já usa a tua localização para definir a recolha e calcular o trajecto do serviço."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "ao.leva.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#34D186"
      }
    },
    "ios": {
      "bundleIdentifier": "ao.leva.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A Leva Já usa a tua localização para definir a recolha e calcular o trajecto do serviço."
      }
    }
  }
}
