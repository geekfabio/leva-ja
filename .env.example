# Copiar para .env (não vai para o git). Só variáveis EXPO_PUBLIC_* chegam à app.
# A app fala sempre com a API real; não há modo de demonstração.

# URL base da API (obrigatório). Em desenvolvimento: http://localhost:4000
EXPO_PUBLIC_API_URL=

# Tempo máximo por pedido HTTP, em ms.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Intervalo do polling de tempo real (pedidos, prestador, chat) quando não há WebSocket, em ms (mín. 1000).
EXPO_PUBLIC_POLL_INTERVAL_MS=5000

# WebSocket do tempo real (ex.: wss://api.angoleva.ao/realtime). Vazio → polling.
EXPO_PUBLIC_REALTIME_URL=

# Mosaicos do mapa na web, formato {z}/{x}/{y}. Vazio → OpenStreetMap.
# Em produção usar um fornecedor próprio: o servidor público do OSM não é para tráfego comercial.
EXPO_PUBLIC_MAP_TILES_URL=

# Serviço de rotas compatível com OSRM. Vazio → router.project-osrm.org (só demonstração).
EXPO_PUBLIC_ROUTING_URL=
