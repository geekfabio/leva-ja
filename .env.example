# Copiar para .env (não vai para o git). Só variáveis EXPO_PUBLIC_* chegam à app.

# Origem dos dados. Nos dois casos os dados chegam no formato da API (docs/api.md):
#   mock → API simulada dentro da app, sobre dados de demonstração (por omissão)
#   http → API real em EXPO_PUBLIC_API_URL
EXPO_PUBLIC_DATA_SOURCE=mock

# URL base da API, obrigatório com EXPO_PUBLIC_DATA_SOURCE=http (ex.: https://api.angoleva.ao/v1).
EXPO_PUBLIC_API_URL=

# Tempo máximo por pedido HTTP, em ms.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Intervalo do polling de tempo real (pedidos, prestador, chat) até haver WebSocket, em ms (mín. 1000).
EXPO_PUBLIC_POLL_INTERVAL_MS=5000

# Posição do utilizador: simulated (ponto em Luanda) ou device (GPS real, via expo-location).
# Por omissão: simulated com EXPO_PUBLIC_DATA_SOURCE=mock e device com http.
EXPO_PUBLIC_LOCATION=

# Fotografias: simulated (fotos de exemplo) ou device (câmara/galeria + envio para POST /uploads).
# Por omissão: simulated com mock e device com http.
EXPO_PUBLIC_CAMERA=

# WebSocket do tempo real (ex.: wss://api.angoleva.ao/v1/realtime). Vazio → polling.
# Em modo mock é ignorado: a API simulada fala o mesmo protocolo dentro da app.
EXPO_PUBLIC_REALTIME_URL=

# Armazenamento da sessão: mock (memória) ou device (expo-secure-store; a web usa sempre mock).
EXPO_PUBLIC_SECURE_STORAGE=mock
