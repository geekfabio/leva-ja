# Copiar para .env (não vai para o git). Só variáveis EXPO_PUBLIC_* chegam à app.

# Origem dos dados: mock (base em memória, por omissão) ou http (API REST).
EXPO_PUBLIC_DATA_SOURCE=mock

# URL base da API, obrigatório com EXPO_PUBLIC_DATA_SOURCE=http.
#   https://api.angoleva.ao/v1  → backend real
#   mock://local                → API simulada dentro da app (testa a camada HTTP sem backend)
EXPO_PUBLIC_API_URL=

# Tempo máximo por pedido HTTP, em ms.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Intervalo do polling de tempo real (pedidos, prestador, chat) até haver WebSocket, em ms (mín. 1000).
EXPO_PUBLIC_POLL_INTERVAL_MS=5000

# Armazenamento da sessão: mock (memória) ou device (expo-secure-store; a web usa sempre mock).
EXPO_PUBLIC_SECURE_STORAGE=mock
