# Produção: URL dos tiles OpenStreetMap do fornecedor contratado.
# Deve manter os placeholders {z}, {x} e {y}.
EXPO_PUBLIC_OSM_TILE_URL=https://tiles.exemplo.ao/{z}/{x}/{y}.png

# Produção: endpoint compatível com a API Route do OSRM.
# A app acrescenta /route/v1/driving automaticamente.
EXPO_PUBLIC_ROUTING_URL=https://osrm.exemplo.ao

# Só para builds Android. Não usar o prefixo EXPO_PUBLIC: esta chave não deve
# ser disponibilizada ao JavaScript da aplicação. Em EAS/GitHub Actions, guardar
# o mesmo valor como segredo GOOGLE_MAPS_ANDROID_API_KEY.
GOOGLE_MAPS_ANDROID_API_KEY=AIza...
